# =====================================================================
# Techliex Management API - Production Environment Variables
# =====================================================================
# Configure these environment variables in your Dokploy application settings

# Database Configuration (For separate Dokploy PostgreSQL Service or VPS Database)
# Option A: Standard JDBC URL
DB_JDBC_URL=jdbc:postgresql://your-vps-db-host:5432/techliex_db
DB_USER=techliex
DB_PASSWORD=your_secure_db_password
DB_DRIVER=org.postgresql.Driver

# Option B: Dokploy / PaaS standard DATABASE_URL format (automatically parsed by app if set)
# DATABASE_URL=postgres://techliex:your_secure_db_password@your-vps-db-host:5432/techliex_db

# Security & JWT Token Settings
JWT_SECRET=your-production-super-secret-jwt-key-2025!
JWT_ISSUER=https://your-domain.com/
JWT_AUDIENCE=https://your-domain.com/api/v1
